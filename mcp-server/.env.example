# LLM generation (OpenAI-compatible). Set OPENAI_BASE_URL to point at a gateway
# or any OpenAI-compatible endpoint if you're not using OpenAI directly.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Per-level model names. Defaults match the reference repo (AI_Data_Agent).
TF_MODEL_LOW=gpt-5.6-luna
TF_MODEL_MEDIUM=gpt-5.6-terra
TF_MODEL_HIGH=gpt-5.6-sol
TF_MODEL_CLAUDE=claude-sonnet-5

# Postgres connection (used by database.py).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# MCP server transport.
MCP_HOST=127.0.0.1
MCP_PORT=8765
