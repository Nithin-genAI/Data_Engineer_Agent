# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM generation ---
# We run on Fireworks, which serves an OpenAI-COMPATIBLE API. That's why the
# `openai` SDK works here unchanged: override the base URL and it talks to
# Fireworks. The SDK reads these two variables itself — they appear nowhere in
# the code. Leave OPENAI_BASE_URL empty and the SDK falls back to OpenAI proper.
OPENAI_API_KEY=fw_your_fireworks_key_here
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Model ids must be what the endpoint understands — against Fireworks that's
# `accounts/fireworks/models/<name>`. A bare gpt-* id will 404 here.
# Only list models that are actually deployed on your Fireworks account.
TF_MODEL_LOW=accounts/fireworks/models/glm-5p2
TF_MODEL_MEDIUM=accounts/fireworks/models/kimi-k3
TF_MODEL_HIGH=accounts/fireworks/models/kimi-k3
TF_MODEL_CLAUDE=accounts/fireworks/models/minimax-m3

# --- Postgres (used by database.py / feed_db.py) ---
# Homebrew installs use your macOS username and no password.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_macos_username
DB_PASSWORD=
DB_NAME=data_agent_db

# --- MCP server transport ---
# Must match the URL registered with TrueForge (see RUNBOOK.md).
MCP_HOST=127.0.0.1
MCP_PORT=8765
